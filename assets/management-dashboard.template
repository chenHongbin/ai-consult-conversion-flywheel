<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>AI咨询管理工作台</title>
  <style>
    :root{--ink:#16241f;--muted:#64736d;--paper:#f2f0e9;--card:#fffdf8;--line:#d9d7ce;--green:#0f5c4c;--mint:#cfe8dc;--lime:#d9f06d;--orange:#e47642;--red:#b94635;--shadow:0 12px 34px rgba(20,38,31,.08)}
    *{box-sizing:border-box}html{background:var(--paper);color:var(--ink);font-family:"Noto Serif SC","Songti SC","STSong",serif}body{margin:0;min-width:320px;background:radial-gradient(circle at 90% 0,rgba(217,240,109,.22),transparent 28rem),linear-gradient(90deg,rgba(15,92,76,.025) 1px,transparent 1px),linear-gradient(rgba(15,92,76,.025) 1px,transparent 1px);background-size:auto,24px 24px,24px 24px}
    button,select{font:inherit}.shell{max-width:1500px;margin:auto;padding:26px}.masthead{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:end;border-bottom:3px solid var(--ink);padding-bottom:18px}.eyebrow{font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:12px;letter-spacing:.2em;color:var(--green);font-weight:800}.masthead h1{font-size:clamp(28px,4vw,52px);line-height:1;margin:8px 0 10px}.meta{font-family:"PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted);font-size:13px}.controls{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.control{border:1px solid var(--line);background:var(--card);padding:10px 13px;border-radius:4px;color:var(--ink)}button.control{cursor:pointer}.period.active{background:var(--ink);color:white;border-color:var(--ink)}
    .hero{margin:22px 0;display:grid;grid-template-columns:minmax(0,1.7fr) minmax(270px,.7fr);background:var(--ink);color:#f7f4e9;box-shadow:var(--shadow)}.hero-main{padding:30px;border-right:1px solid rgba(255,255,255,.18)}.hero-label{font-family:"PingFang SC","Microsoft YaHei",sans-serif;color:var(--lime);font-size:12px;letter-spacing:.15em;font-weight:800}.hero h2{font-size:clamp(26px,4vw,48px);line-height:1.2;margin:12px 0}.hero-action{border-left:4px solid var(--lime);padding-left:14px;font-size:18px}.hero-side{display:grid;grid-template-columns:1fr 1fr}.stat{padding:22px;border:1px solid rgba(255,255,255,.12)}.stat b{display:block;font-size:32px;color:var(--lime)}.stat span{font:12px "PingFang SC","Microsoft YaHei",sans-serif;color:#c9d1cd}
    .grid{display:grid;grid-template-columns:repeat(12,1fr);gap:18px}.card{grid-column:span 6;background:rgba(255,253,248,.94);border:1px solid var(--line);box-shadow:var(--shadow);padding:22px;min-width:0}.wide{grid-column:span 12}.card-head{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:15px}.card h3{margin:0;font-size:22px}.kicker{font:11px "PingFang SC","Microsoft YaHei",sans-serif;color:var(--green);letter-spacing:.12em;font-weight:800}.empty{padding:28px;border:1px dashed var(--line);color:var(--muted);text-align:center}.task{display:grid;grid-template-columns:48px 1fr auto;gap:14px;padding:15px 0;border-top:1px solid var(--line);align-items:start}.priority{font:800 12px "PingFang SC","Microsoft YaHei",sans-serif;border:1px solid;padding:4px 6px;text-align:center}.P0{color:var(--red);border-color:var(--red)}.P1{color:var(--orange);border-color:var(--orange)}.P2{color:var(--green);border-color:var(--green)}.task-title{font-weight:800}.task-meta,.subtle{font:12px/1.6 "PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted)}.copy{border:0;background:var(--mint);color:var(--green);padding:7px 9px;cursor:pointer;border-radius:3px;font:12px "PingFang SC","Microsoft YaHei",sans-serif}.copy:focus{outline:3px solid var(--lime)}
    .training{display:grid;gap:12px}.training-focus{font-size:28px;font-weight:800}.compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}.compare>div{padding:14px;background:#f4f2ea;border-top:4px solid var(--line)}.compare .good{border-color:var(--green)}.compare .bad{border-color:var(--orange)}
    .table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;min-width:760px}th,td{text-align:left;padding:13px 12px;border-bottom:1px solid var(--line);vertical-align:top}th{font:800 11px "PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted);letter-spacing:.08em}.status{display:inline-block;border-radius:999px;padding:4px 9px;background:var(--mint);color:var(--green);font:12px "PingFang SC","Microsoft YaHei",sans-serif}
    .funnel{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.funnel-step{background:var(--green);color:white;padding:18px;clip-path:polygon(0 0,92% 0,100% 50%,92% 100%,0 100%,8% 50%)}.funnel-step:first-child{clip-path:polygon(0 0,92% 0,100% 50%,92% 100%,0 100%)}.funnel-step b{display:block;font-size:28px}.funnel-step span{font:12px "PingFang SC","Microsoft YaHei",sans-serif}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:14px}.metric{border:1px solid var(--line);padding:13px}.metric b{display:block;font-size:20px}.metric span{font:11px "PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted)}.trend{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin-top:10px}.trend>div{border-left:3px solid var(--lime);padding:8px;background:#f4f2ea}.trend b{display:block}.local-link{display:inline-block;margin:8px 8px 0 0;color:var(--green);font-weight:800}
    .pipeline{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}.stage{padding:15px;border-top:4px solid var(--green);background:#f4f2ea}.stage b{font-size:26px}.stage span{display:block;font:11px/1.5 "PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted)}
    details{border-top:1px solid var(--line);padding:12px 0}summary{cursor:pointer;font-weight:800}.evidence{font:12px/1.7 "PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted);word-break:break-all}.footer{margin-top:22px;border-top:3px solid var(--ink);padding:16px 0 30px;display:flex;gap:18px;flex-wrap:wrap;font:12px "PingFang SC","Microsoft YaHei",sans-serif;color:var(--muted)}.demo{background:var(--lime);color:var(--ink);padding:6px 10px;font-weight:800}.hidden{display:none!important}
    @media(max-width:920px){.hero{grid-template-columns:1fr}.hero-main{border-right:0}.card{grid-column:span 12}.metrics{grid-template-columns:1fr 1fr}.pipeline{grid-template-columns:1fr 1fr 1fr}.masthead{grid-template-columns:1fr}.controls{justify-content:flex-start}}
    @media(max-width:600px){.shell{padding:15px}.hero-side{grid-template-columns:1fr 1fr}.funnel{grid-template-columns:1fr 1fr}.funnel-step{clip-path:none}.compare,.metrics,.pipeline,.trend{grid-template-columns:1fr}.task{grid-template-columns:42px 1fr}.task .copy{grid-column:2}.card{padding:17px}}
    @media(prefers-reduced-motion:no-preference){.card,.hero{animation:rise .45s ease both}.card:nth-child(2){animation-delay:.06s}.card:nth-child(3){animation-delay:.12s}@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}}
  </style>
</head>
<body>
<main class="shell">
  <header class="masthead">
    <div><div class="eyebrow">AI CONSULTATION OPERATIONS</div><h1>咨询管理工作台</h1><div id="meta" class="meta"></div></div>
    <div class="controls"><button class="control period" data-period="today">今日</button><button class="control period" data-period="week">本周</button><button class="control period" data-period="month">本月</button><select id="employeeFilter" class="control" aria-label="按员工筛选"><option value="">全部员工</option></select></div>
  </header>
  <section class="hero"><div class="hero-main"><div class="hero-label">今日管理结论</div><h2 id="mainBreakpoint"></h2><p id="mainAction" class="hero-action"></p><div id="reviewStandard" class="subtle"></div></div><div class="hero-side"><div class="stat"><b id="taskCount">0</b><span>待处理任务</span></div><div class="stat"><b id="employeeCount">0</b><span>待辅导员工</span></div><div class="stat"><b id="candidateCount">0</b><span>女娲候选</span></div><div class="stat"><b id="missingCount">0</b><span>关键数据缺口</span></div></div></section>
  <div class="grid">
    <section class="card"><div class="card-head"><div><div class="kicker">PRIORITY QUEUE</div><h3>今日管理待办</h3></div></div><div id="tasks"></div></section>
    <section class="card"><div class="card-head"><div><div class="kicker">ONE ACTION ONLY</div><h3>今日训练主题</h3></div></div><div id="training"></div></section>
    <section class="card wide"><div class="card-head"><div><div class="kicker">COACHING PROGRESS</div><h3>重点员工与辅导进度</h3></div></div><div class="subtle">每人每周期只显示一个主要动作</div></div><div class="table-wrap"><table><thead><tr><th>员工</th><th>主要断点</th><th>已验证优势</th><th>本期唯一动作</th><th>复查样本</th><th>状态</th><th>有效到院</th><th>结果变化</th></tr></thead><tbody id="employees"></tbody></table></div></section>
    <section class="card"><div class="card-head"><div><div class="kicker">BUSINESS OUTCOMES</div><h3>团队结果快照</h3></div></div><div id="outcomes"></div></section>
    <section class="card"><div class="card-head"><div><div class="kicker">NUWA LEARNING</div><h3>女娲学习与能力复制</h3></div></div><div id="capabilities"></div></section>
    <section class="card wide"><div class="card-head"><div><div class="kicker">TRACEABLE EVIDENCE</div><h3>管理结论证据</h3></div></div></div><div id="evidence"></div></section>
  </div>
  <footer id="footer" class="footer"></footer>
</main>
<script id="dashboard-data" type="application/json">__DASHBOARD_DATA__</script>
<script>
(function(){
  'use strict';
  var all=JSON.parse(document.getElementById('dashboard-data').textContent), currentPeriod=all.selected_period||'today', currentEmployee='';
  function esc(v){return String(v==null?'':v).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
  function pct(m){return !m||m.status!=='known'?'暂不能判断':(m.value*100).toFixed(1)+'%'}
  function num(v){return v==null?'缺失':Math.round(v)}
  function getData(){return (all.periods&&all.periods[currentPeriod])||all}
  function render(){var d=getData(), summary=d.summary||{}, tasks=(d.tasks||[]).filter(function(t){return !currentEmployee||t.target===currentEmployee||t.target_id===currentEmployee}), employees=(d.employees||[]).filter(function(e){return !currentEmployee||e.employee_id===currentEmployee});
    document.querySelectorAll('.period').forEach(function(b){b.classList.toggle('active',b.getAttribute('data-period')===currentPeriod)});
    document.getElementById('meta').innerHTML=esc(all.institution||'当前机构')+' · '+esc(all.team||'当前团队')+' · '+esc(d.start||'')+' 至 '+esc(d.end||'')+' · 更新于 '+esc(all.generated_at)+(all.demo?'<span class="demo">合成演示</span>':'');
    document.getElementById('mainBreakpoint').textContent=summary.main_breakpoint||'尚无足够样本识别团队断点';document.getElementById('mainAction').textContent=summary.today_action||'先放入一通录音或一段微信，系统会从第一个片段开始。';document.getElementById('reviewStandard').textContent='明日复查：'+(summary.review_standard||'待建立复查样本');
    document.getElementById('taskCount').textContent=tasks.filter(function(t){return ['completed','reviewed'].indexOf(t.status)<0}).length;document.getElementById('employeeCount').textContent=employees.filter(function(e){return e.status!=='verified'}).length;document.getElementById('candidateCount').textContent=(d.capability_counts||{}).candidate_experience||0;document.getElementById('missingCount').textContent=(d.data_status||{}).missing_count||0;
    document.getElementById('tasks').innerHTML=tasks.length?tasks.map(function(t){return `<article class="task"><span class="priority ${esc(t.priority||'P2')}">${esc(t.priority||'P2')}</span><div><div class="task-title">${esc(t.action||t.reason||t.task_id)}</div><div class="task-meta">${esc(t.target||'团队')} · ${esc(t.reason||'')} · ${esc(t.status||'pending')}</div></div><button class="copy" data-copy="${esc(t.command||('处理管理任务 '+t.task_id))}">复制指令</button></article>`}).join(''):'<div class="empty">本周期没有待办。放入新样本或运行夜间循环后会自动生成。</div>';
    var tr=d.training||{};document.getElementById('training').innerHTML=tr.title?`<div class="training"><div class="training-focus">${esc(tr.title)}</div><div class="subtle">${esc(tr.reason||'')}</div><div class="compare"><div class="bad"><b>失败对照</b><div class="subtle">${esc((tr.failure_refs||[]).join('、')||'待补充')}</div></div><div class="good"><b>销冠示范</b><div class="subtle">${esc((tr.champion_refs||[]).join('、')||'待补充')}</div></div></div><div><b>今天只练：</b>${esc(tr.key_action||'')}</div><div><b>通过标准：</b>${esc(tr.pass_criteria||'')}</div><button class="copy" data-copy="${esc(tr.command||'生成今天的晨会训练')}">复制晨会指令</button></div>`:'<div class="empty">尚未建立训练任务。</div>';
    document.getElementById('employees').innerHTML=employees.length?employees.map(function(e){return `<tr><td><b>${esc(e.employee_name||e.employee_id)}</b><div class="subtle">${esc(e.employee_id)}</div></td><td>${esc(e.main_breakpoint||'未知')}</td><td>${esc(e.verified_strength||'待验证')}</td><td>${esc(e.training_action||'待建立')}</td><td>${esc(e.review_sample_count||0)}</td><td><span class="status">${esc(e.status||'pending')}</span></td><td>${num(e.effective_arrivals)}</td><td>${esc(e.outcome_change||'结果待观察')}</td></tr>`}).join(''):'<tr><td colspan="8"><div class="empty">没有可展示的员工样本。</div></td></tr>';
    var o=d.outcomes||{}, totals=o.totals||{}, metrics=o.metrics||{}, mm=d.management_metrics||{}, trend=o.weekly_trend||[];document.getElementById('outcomes').innerHTML=`<div class="funnel"><div class="funnel-step"><b>${num(totals.effective_consultations)}</b><span>有效咨询</span></div><div class="funnel-step"><b>${num(totals.appointments)}</b><span>预约</span></div><div class="funnel-step"><b>${num(totals.arrivals)}</b><span>到院</span></div><div class="funnel-step"><b>${num(totals.paid_cases)}</b><span>成交</span></div></div><div class="metrics"><div class="metric"><b>${pct(metrics.consultation_conversion_rate)}</b><span>咨询转化率</span></div><div class="metric"><b>${pct(metrics.appointment_arrival_rate)}</b><span>预约到院率</span></div><div class="metric"><b>${pct(metrics.effective_consultation_arrival_rate)}</b><span>有效咨询到院率</span></div><div class="metric"><b>${pct(metrics.arrival_paid_rate)}</b><span>到院成交率</span></div><div class="metric"><b>${pct(mm.training_adoption_rate)}</b><span>训练采用率</span></div><div class="metric"><b>${pct(mm.training_review_pass_rate)}</b><span>复查通过率</span></div><div class="metric"><b>${pct(mm.champion_replication_rate)}</b><span>销冠动作复制率</span></div></div><div class="trend">${trend.map(function(w){return `<div><span class="subtle">${esc(w.start.slice(5))}—${esc(w.end.slice(5))}</span><b>${num(w.arrivals)} 到院</b><span class="subtle">预约到院 ${pct(w.appointment_arrival_rate)}</span></div>`}).join('')}</div><p class="subtle">${esc(o.note||'所有指标均标注数据完整性。')} 主管复核耗时：${esc((mm.manager_review_minutes||{}).value==null?'缺失':mm.manager_review_minutes.value+'分钟')}</p>`;
    var c=d.capability_counts||{};document.getElementById('capabilities').innerHTML=`<div class="pipeline"><div class="stage"><b>${esc(c.candidate_experience||0)}</b><span>候选经验</span></div><div class="stage"><b>${esc(c.trainable_action||0)}</b><span>可训练动作</span></div><div class="stage"><b>${esc(c.behavior_verified||0)}</b><span>行为已验证</span></div><div class="stage"><b>${esc(c.outcome_verified||0)}</b><span>结果已验证</span></div><div class="stage"><b>${esc(c.team_capability||0)}</b><span>团队正式能力</span></div></div><p class="subtle">最近能力包：${esc((d.data_status||{}).capability_version||'base_only')}</p>`;
    document.getElementById('evidence').innerHTML=(d.evidence||[]).length?(d.evidence||[]).map(function(e){var links=(e.links||[]).map(function(p){var href=/^(\/|file:)/.test(p)?p:'../../../../'+p;return `<a class="local-link" href="${esc(href)}">打开本地证据</a>`}).join('');return `<details><summary>${esc(e.label||e.sample_id)}</summary><div class="evidence">${esc((e.refs||[]).join(' · ')||'证据不足')}</div>${links}</details>`}).join(''):'<div class="empty">证据不足。管理结论不会被伪装成确定事实。</div>';
    var s=d.data_status||{};document.getElementById('footer').innerHTML=`<span>夜间处理：待处理 ${esc(s.pending_analysis_count||0)}</span><span>失败 ${esc(s.failed_item_count||0)}</span><span>样本 ${esc(s.sample_count||0)}</span><span>结果缺口 ${esc(s.missing_count||0)}</span><span>数据完整性 ${esc(s.data_completeness||'missing')}</span><span>能力版本 ${esc(s.capability_version||'base_only')}</span>`;
    bindCopies();
  }
  function bindCopies(){document.querySelectorAll('[data-copy]').forEach(function(b){b.onclick=function(){var text=b.getAttribute('data-copy');if(navigator.clipboard){navigator.clipboard.writeText(text)}else{var x=document.createElement('textarea');x.value=text;document.body.appendChild(x);x.select();document.execCommand('copy');x.remove()}b.textContent='已复制';setTimeout(function(){b.textContent='复制指令'},1000)}})}
  document.querySelectorAll('.period').forEach(function(b){b.onclick=function(){currentPeriod=b.getAttribute('data-period');render()}});document.getElementById('employeeFilter').onchange=function(){currentEmployee=this.value;render()};
  (all.employee_options||[]).forEach(function(e){var o=document.createElement('option');o.value=e.employee_id;o.textContent=e.employee_name||e.employee_id;document.getElementById('employeeFilter').appendChild(o)});render();
})();
</script>
</body>
</html>
